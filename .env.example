# 复制为 .env 后按需修改；全部留空也能跑（密码与主密钥会自动生成）
# chmod 600 .env

# 控制台登录密码。留空 = 首启自动生成，保存到 data/admin_token，日志里打印一次
ADMIN_TOKEN=

# 32 字节随机值的 base64（44 字符，以 = 结尾）。留空 = 首启自动生成到 data/master.key
# 生成：openssl rand -base64 32
# 注意：换掉 MASTER_KEY 会让已存的账号 Token 全部解不开，只能重新扫码
MASTER_KEY=

# 每天自动签到的时间（北京时间，逗号分隔）。留空 = 关闭定时任务
CRON_SCHEDULE=08:10,00:20

# /cron 接口的独立口令，留空则回落到 ADMIN_TOKEN
CRON_SECRET=
