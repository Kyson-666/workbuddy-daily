# 复制为 .env 后按需修改；全部留空也能跑（密码与主密钥会自动生成）
# chmod 600 .env

# 控制台登录密码。留空 = 首启自动生成，保存到 data/admin_token，日志里打印一次
ADMIN_TOKEN=

# 32 字节随机值的 base64（44 字符，以 = 结尾）。留空 = 首启自动生成到 data/master.key
# 生成：openssl rand -base64 32
# 注意：换掉 MASTER_KEY 会让已存的账号 Token 全部解不开，只能重新扫码
MASTER_KEY=

# 每天自动签到的时间（北京时间，逗号分隔）。留空 = 关闭定时任务
CRON_SCHEDULE=08:10,00:20

# /cron 接口的独立口令，留空则回落到 ADMIN_TOKEN
CRON_SECRET=

# DuMate 扩展包托管目录（容器内路径）。留空用默认 /data/extension
# docker compose 已把宿主 ./dumate-extension 挂载到这里，更新扩展替换宿主目录文件即可
DUMATE_EXTENSION_DIR=

# 保活刷新：连续这么久没签到成功的账号，每天固定时间只刷新令牌、不签到。
# 留空或 0 = 关闭（默认关闭）。
# 注意：Trae / WorkBuddy / Qoder 的 refreshToken 都是轮换制，刷新一次会让官方客户端里
# 的旧令牌失效。如果你平时也在用官方客户端，请不要打开这个开关。
KEEPALIVE_DAYS=
KEEPALIVE_TIME=12:30

# DuMate 独立会话保活：固定每 4 小时（每天 6 次）用 cookie 只读打一次
# GET /api/dumate/points/loginBonusInfo，把 24 小时内最大间隔压到 4 小时。
# 只读、幂等、无副作用；只针对 DuMate，不会给 Trae / WorkBuddy / Qoder 发请求。
# 默认生效（下方即默认值）；填 off 可关闭。
DUMATE_KEEPALIVE_SLOTS=00:05,04:05,08:05,12:05,16:05,20:05

# 访问日志：1 = 打印每个请求的方法、路径、状态码、耗时、UA。
# 排查反向代理 404 之类问题时打开，平时关掉。
LOG_REQUESTS=
